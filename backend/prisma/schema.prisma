generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  passwordHash        String
  passwordChangedAt   DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  jobs                Job[]
  passwordResetTokens PasswordResetToken[]
}

enum JobType {
  part_time
  mini_job
}

model Job {
  id                     String   @id @default(cuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                   String
  hourlyRate             Decimal  @db.Decimal(8, 2)
  type                   JobType
  vacationHoursPerYear   Decimal? @db.Decimal(6, 2)
  vacationCarryOverHours Decimal  @default(0) @db.Decimal(6, 2)
  vacationCarryOverYear  Int?
  leave                  Leave[]
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  shifts                 Shift[]

  @@index([userId])
}

model Shift {
  id           String   @id @default(cuid())
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  startTime    String   @db.VarChar(5)
  endTime      String   @db.VarChar(5)
  breakMinutes Int      @default(0)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([jobId, date])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum LeaveType {
  paid_vacation
}

model Leave {
  id            String    @id @default(cuid())
  jobId         String
  job           Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type          LeaveType @default(paid_vacation)
  startDate     DateTime  @db.Date
  endDate       DateTime  @db.Date
  weekdays      Int[]
  minutesPerDay Int
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([jobId, startDate])
}
