# Controls cookie security settings (Secure/SameSite differ between a
# same-site local setup and cross-site production). Optional — defaults
# to "development" if unset.
NODE_ENV=development

# Postgres connection string. This value matches docker-compose.yml's
# postgres service for local dev.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/life_tracker?schema=public"

# Port the Express server listens on. Optional — defaults to 4000 if unset.
PORT=4000

# bcrypt hashing cost. Optional — defaults to 12 if unset.
BCRYPT_COST=12

# The one frontend origin allowed to make credentialed requests.
CORS_ORIGIN=http://localhost:5173

# Separate secrets for access vs. refresh tokens, so a leaked access-token
# secret alone can't be used to forge refresh tokens. Generate real values
# with e.g. `openssl rand -hex 32` — never reuse these placeholders.
JWT_ACCESS_SECRET=replace-with-a-real-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-real-random-secret
