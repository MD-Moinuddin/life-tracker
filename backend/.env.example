# Postgres connection string. This value matches docker-compose.yml's
# postgres service for local dev.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/life_tracker?schema=public"

# Port the Express server listens on. Optional — defaults to 4000 if unset.
PORT=4000

# bcrypt hashing cost. Optional — defaults to 12 if unset.
BCRYPT_COST=12

# The one frontend origin allowed to make credentialed requests.
CORS_ORIGIN=http://localhost:5173
